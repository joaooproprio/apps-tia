<?xml version="1.0" encoding="utf-8"?>
<!-- Última alteração: 29/09/2026 00:09 -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/white"
    android:fillViewport="true">

    <LinearLayout
        android:id="@+id/raizDiscador"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@android:color/white"
        android:minHeight="600dp"
        android:orientation="vertical"
            android:weightSum="100">

        <View
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="2" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="15"
            android:orientation="horizontal"
            android:weightSum="95">

            <TextView
                android:id="@+id/tvDisplay"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="70"
                android:gravity="center|bottom"
                android:padding="16dp"
                android:text=""
                android:textColor="@android:color/black"
                android:maxLines="1"
                android:textSize="40sp" />

            <View
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="5" />

            <android.widget.Button
                android:id="@+id/btnClear"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="20"
                android:background="@drawable/tecla_discador"
                android:backgroundTint="#F44336"
                android:stateListAnimator="@null"
                android:text="@string/botao_limpa_digitado"
                android:textColor="@android:color/white"
                android:autoSizeTextType="uniform"
                android:textSize="30sp"
                android:textStyle="bold" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="2" />

        <GridLayout
            android:id="@+id/dialPad"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="50"
            android:background="#EEEEEE"
            android:columnCount="3"
            android:rowCount="4"
            android:padding="1dp">

            <android.widget.Button android:id="@+id/btn1" android:layout_width="0dp" android:layout_height="0dp" android:text="@string/botao_1" android:background="@drawable/tecla_discador" android:backgroundTint="@android:color/white" android:stateListAnimator="@null" android:textSize="35sp" android:autoSizeTextType="uniform" android:layout_columnWeight="1" android:layout_rowWeight="1" android:textColor="@android:color/black" android:layout_margin="6dp"/>
            <android.widget.Button android:id="@+id/btn2" android:layout_width="0dp" android:layout_height="0dp" android:text="@string/botao_2" android:background="@drawable/tecla_discador" android:backgroundTint="@android:color/white" android:stateListAnimator="@null" android:textSize="35sp" android:autoSizeTextType="uniform" android:layout_columnWeight="1" android:layout_rowWeight="1" android:textColor="@android:color/black" android:layout_margin="6dp"/>
            <android.widget.Button android:id="@+id/btn3" android:layout_width="0dp" android:layout_height="0dp" android:text="@string/botao_3" android:background="@drawable/tecla_discador" android:backgroundTint="@android:color/white" android:stateListAnimator="@null" android:textSize="35sp" android:autoSizeTextType="uniform" android:layout_columnWeight="1" android:layout_rowWeight="1" android:textColor="@android:color/black" android:layout_margin="6dp"/>
            <android.widget.Button android:id="@+id/btn4" android:layout_width="0dp" android:layout_height="0dp" android:text="@string/botao_4" android:background="@drawable/tecla_discador" android:backgroundTint="@android:color/white" android:stateListAnimator="@null" android:textSize="35sp" android:autoSizeTextType="uniform" android:layout_columnWeight="1" android:layout_rowWeight="1" android:textColor="@android:color/black" android:layout_margin="6dp"/>
            <android.widget.Button android:id="@+id/btn5" android:layout_width="0dp" android:layout_height="0dp" android:text="@string/botao_5" android:background="@drawable/tecla_discador" android:backgroundTint="@android:color/white" android:stateListAnimator="@null" android:textSize="35sp" android:autoSizeTextType="uniform" android:layout_columnWeight="1" android:layout_rowWeight="1" android:textColor="@android:color/black" android:layout_margin="6dp"/>
            <android.widget.Button android:id="@+id/btn6" android:layout_width="0dp" android:layout_height="0dp" android:text="@string/botao_6" android:background="@drawable/tecla_discador" android:backgroundTint="@android:color/white" android:stateListAnimator="@null" android:textSize="35sp" android:autoSizeTextType="uniform" android:layout_columnWeight="1" android:layout_rowWeight="1" android:textColor="@android:color/black" android:layout_margin="6dp"/>
            <android.widget.Button android:id="@+id/btn7" android:layout_width="0dp" android:layout_height="0dp" android:text="@string/botao_7" android:background="@drawable/tecla_discador" android:backgroundTint="@android:color/white" android:stateListAnimator="@null" android:textSize="35sp" android:autoSizeTextType="uniform" android:layout_columnWeight="1" android:layout_rowWeight="1" android:textColor="@android:color/black" android:layout_margin="6dp"/>
            <android.widget.Button android:id="@+id/btn8" android:layout_width="0dp" android:layout_height="0dp" android:text="@string/botao_8" android:background="@drawable/tecla_discador" android:backgroundTint="@android:color/white" android:stateListAnimator="@null" android:textSize="35sp" android:autoSizeTextType="uniform" android:layout_columnWeight="1" android:layout_rowWeight="1" android:textColor="@android:color/black" android:layout_margin="6dp"/>
            <android.widget.Button android:id="@+id/btn9" android:layout_width="0dp" android:layout_height="0dp" android:text="@string/botao_9" android:background="@drawable/tecla_discador" android:backgroundTint="@android:color/white" android:stateListAnimator="@null" android:textSize="35sp" android:autoSizeTextType="uniform" android:layout_columnWeight="1" android:layout_rowWeight="1" android:textColor="@android:color/black" android:layout_margin="6dp"/>
            <android.widget.Button android:id="@+id/btnasterisco" android:layout_width="0dp" android:layout_height="0dp" android:text="@string/botao_asterisco" android:background="@drawable/tecla_discador" android:backgroundTint="@android:color/white" android:stateListAnimator="@null" android:textSize="30sp" android:autoSizeTextType="uniform" android:layout_columnWeight="1" android:layout_rowWeight="1" android:textColor="@android:color/black" android:layout_margin="6dp"/>
            <android.widget.Button android:id="@+id/btn0" android:layout_width="0dp" android:layout_height="0dp" android:text="@string/botao_0" android:background="@drawable/tecla_discador" android:backgroundTint="@android:color/white" android:stateListAnimator="@null" android:textSize="35sp" android:autoSizeTextType="uniform" android:layout_columnWeight="1" android:layout_rowWeight="1" android:textColor="@android:color/black" android:layout_margin="6dp"/>
            <android.widget.Button android:id="@+id/btnjogodavelha" android:layout_width="0dp" android:layout_height="0dp" android:text="@string/botao_jogodavelha" android:background="@drawable/tecla_discador" android:backgroundTint="@android:color/white" android:stateListAnimator="@null" android:textSize="30sp" android:autoSizeTextType="uniform" android:layout_columnWeight="1" android:layout_rowWeight="1" android:textColor="@android:color/black" android:layout_margin="6dp"/>
        </GridLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="2" />

        <Button
            android:id="@+id/btnCall"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="14"
            android:layout_marginHorizontal="10dp"
            android:background="@drawable/tecla_discador"
            android:backgroundTint="#4CAF50"
            android:stateListAnimator="@null"
            android:text="@string/botao_ligar"
            android:textColor="@android:color/white"
            android:autoSizeTextType="uniform"
            android:textSize="40sp" />

        <View
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="2" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="13"
            android:layout_marginHorizontal="10dp"
            android:layout_marginBottom="10dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnHistorico"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="47"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:padding="4dp"
                android:background="@drawable/tecla_discador"
                android:backgroundTint="#607D8B"
                android:stateListAnimator="@null"
                android:text="@string/botao_historico"
                android:textColor="@android:color/white"
                android:textStyle="bold"
                android:maxLines="1"
                android:autoSizeTextType="uniform"
                android:autoSizeMinTextSize="14sp"
                android:autoSizeMaxTextSize="28sp"
                android:textSize="28sp" />

            <View
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="6" />

            <Button
                android:id="@+id/btnContacts"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="47"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:padding="4dp"
                android:background="@drawable/tecla_discador"
                android:backgroundTint="#2196F3"
                android:stateListAnimator="@null"
                android:text="@string/botao_contatos"
                android:textColor="@android:color/white"
                android:textStyle="bold"
                android:maxLines="1"
                android:autoSizeTextType="uniform"
                android:autoSizeMinTextSize="14sp"
                android:autoSizeMaxTextSize="28sp"
                android:textSize="28sp" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>
