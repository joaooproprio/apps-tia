<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:id="@+id/raiz"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/fundo"
        android:orientation="vertical"
        android:weightSum="440">

        <Space
            android:id="@+id/vaoTopo"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="25" />

        <Button
            android:id="@+id/btnJoao"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="120"
            android:background="@color/joao"
            android:backgroundTint="@null"
            android:gravity="center"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:paddingStart="4dp"
            android:paddingEnd="4dp"
            android:text="@string/botao_joao"
            android:textColor="@color/joao_texto"
            android:textStyle="bold"
            android:autoSizeTextType="uniform"
            android:autoSizeMinTextSize="32sp"
            android:autoSizeMaxTextSize="300sp"
            android:autoSizeStepGranularity="1sp" />

        <Space
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="25" />

        <Button
            android:id="@+id/btnJanete"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="120"
            android:background="@color/janete"
            android:backgroundTint="@null"
            android:gravity="center"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:paddingStart="4dp"
            android:paddingEnd="4dp"
            android:text="@string/botao_janete"
            android:textColor="@color/janete_texto"
            android:textStyle="bold"
            android:autoSizeTextType="uniform"
            android:autoSizeMinTextSize="32sp"
            android:autoSizeMaxTextSize="300sp"
            android:autoSizeStepGranularity="1sp" />

        <Space
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="25" />

        <LinearLayout
            android:id="@+id/linhaBaixo"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="60"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnWhatsapp"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@color/whatsapp"
                android:backgroundTint="@null"
                android:drawableTop="@drawable/ic_whatsapp"
                android:drawablePadding="2dp"
                android:gravity="center"
                android:maxLines="1"
                android:padding="4dp"
                android:text="@string/botao_whatsapp"
                android:textColor="@color/whatsapp_texto"
                android:textSize="14sp"
                android:textStyle="bold" />

            <Space
                android:id="@+id/vaoMeio"
                android:layout_width="0dp"
                android:layout_height="match_parent" />

            <Button
                android:id="@+id/btnApps"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@color/apps"
                android:backgroundTint="@null"
                android:gravity="center"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:paddingStart="4dp"
                android:paddingEnd="4dp"
                android:text="@string/botao_apps"
                android:textColor="@color/apps_texto"
                android:textStyle="bold"
                android:autoSizeTextType="uniform"
                android:autoSizeMinTextSize="14sp"
                android:autoSizeMaxTextSize="120sp"
                android:autoSizeStepGranularity="1sp" />
        </LinearLayout>

        <Space
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="65" />
    </LinearLayout>

    <TextView
        android:id="@+id/tvErro"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="@color/armado"
        android:gravity="center"
        android:padding="16dp"
        android:textColor="@color/armado_texto"
        android:textSize="32sp"
        android:textStyle="bold"
        android:visibility="gone" />

    <TextView
        android:id="@+id/tvPreparacao"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/fundo"
        android:gravity="center"
        android:padding="24dp"
        android:text="@string/em_preparacao"
        android:textColor="@color/preparacao_texto"
        android:textSize="48sp"
        android:textStyle="bold" />

</FrameLayout>
